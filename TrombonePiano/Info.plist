<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Trombone Piano uses this so the keys can play from the built-in speaker while this device is connected to a computer. It does not record.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Trombone Piano advertises as a Bluetooth MIDI keyboard so a computer can receive the notes.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Trombone Piano advertises a MIDI session on the local network so a computer can receive the notes.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_apple-midi._udp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
